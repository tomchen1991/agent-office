[Unit]
Description=Agent Office read-only presence backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-office
Group=agent-office
WorkingDirectory=/opt/agent-office/current
Environment=NODE_ENV=production
Environment=OFFICE_PRESENCE_LOOPBACK=1
Environment=OFFICE_PRESENCE_CONFIG=/etc/agent-office/presence.json
ExecStart=/usr/bin/node /opt/agent-office/current/server/presenceServer.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
UMask=0077
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
