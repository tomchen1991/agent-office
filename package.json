{
  "name": "agent-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent virtual office visual prototype",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-webp.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "verify:assets": "node scripts/verify-assets.ts",
    "check": "npm run test && npm run verify:assets && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
