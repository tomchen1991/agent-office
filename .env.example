# Browser connects DIRECTLY to the collector. Public URL only, never credentials.
# The collector must allow the Office browser Origin and browser-compatible read-only access.
# Current collector production endpoint is machine-only; see docs/presence-direct.md.
VITE_PRESENCE_WS_URL=wss://collect.falsita.cn/api/presence/v1/ws

# Optional Node/Electron adapter library only (not an Office web backend).
# The adapter caller supplies these values; never use VITE_ variables for tokens.
COLLECT_BASE_URL=http://127.0.0.1:8787
COLLECT_CONSUMER_TOKEN=
