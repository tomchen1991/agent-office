# Public read-only URL only, never credentials. Production uses the same-origin Nginx relay.
# Nginx checks the exact Office Origin; localhost development must use an explicit local endpoint.
# See docs/presence-direct.md for the relay trust boundary.
VITE_PRESENCE_WS_URL=wss://office.falsita.cn/api/presence/v1/ws

# Optional Node/Electron adapter library only (not an Office web backend).
# The adapter caller supplies these values; never use VITE_ variables for tokens.
COLLECT_BASE_URL=http://127.0.0.1:8787
COLLECT_CONSUMER_TOKEN=
